# OpenAI 兼容的 AI 接口（可换成 DeepSeek / 通义 / 本地 Ollama 等）
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-key
AI_MODEL=gpt-4o-mini

# NetBox MCP 服务地址（HTTP 传输，默认端点 /mcp）
MCP_URL=http://127.0.0.1:8000/mcp
# 若 MCP 服务启用了 MCP_AUTH_TOKEN，填写对应 Bearer Token
MCP_TOKEN=

# 提示词（可选；长文本更推荐写在 config.yaml 或独立文件）
# SYSTEM_PROMPT=你是 NetBox 助手...
# USER_PROMPT_TEMPLATE=请整理并查询：\n{message}
# SYSTEM_PROMPT_FILE=prompts/system.txt
# USER_PROMPT_TEMPLATE_FILE=prompts/user_template.txt
